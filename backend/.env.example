# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Public URL of this API as reachable from git providers (used to build the
# webhook URL shown to the user in the org setup guide). When unset we fall
# back to http://localhost:<PORT>. In production, set this to your tunnel /
# load-balancer URL e.g. https://api.example.com
# PUBLIC_API_URL=https://api.example.com

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Database (PostgreSQL) ---
# Docker: docker run -d --name pr-review-db -e POSTGRES_PASSWORD=password -e POSTGRES_DB=pr_review -p 5432:5432 postgres:16
DATABASE_URL=postgres://postgres:password@localhost:5432/pr_review

# --- AI providers (Anthropic / OpenRouter / Gemini / OpenAI) ---
# API keys are NOT configured here. Add them per user/org in the app
# (Settings → Models). Keys are stored encrypted and resolved per request;
# the model for each provider is also selected there, with a code default
# applied otherwise.

# --- Git providers (GitHub / GitLab / Bitbucket) ---
# Provider API keys & webhook secrets are NOT configured here. Create an
# organization in the app and add its API key under Settings → API Keys; the
# webhook secret is generated per organization. Credentials are stored
# encrypted and resolved per request.

# --- Review pipeline tuning ---
# Maximum concurrent review jobs the in-process queue will run at once
JOB_CONCURRENCY=2
# Minimum confidence (0-1) for findings to be kept after agents return
MIN_FINDING_CONFIDENCE=0.75
# How many times a failed job is retried (exponential backoff: 5s, 15s, 45s...)
JOB_MAX_ATTEMPTS=2

# --- Token encryption ---
# 32-byte hex key for AES-256-GCM. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace_with_32_bytes_hex_string_of_64_chars_total_______________
